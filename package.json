{
  "name": "obscura-backend-v2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json",
    "proto:gen": "node scripts/proto-gen.js",
    "seed:papers": "ts-node -r tsconfig-paths/register scripts/seed-papers.ts",
    "validate:sinhala": "ts-node -r tsconfig-paths/register scripts/validate-sinhala-retrieval.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cohere-ai": "^8.0.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "grpc-tools": "1.9.1",
    "jest": "^29.5.0",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "supabase": "^2.109.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/proto/(.*)$": "<rootDir>/libs/proto/src/$1",
      "^@app/proto$": "<rootDir>/libs/proto/src",
      "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/common$": "<rootDir>/libs/common/src",
      "^@app/database/(.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/database$": "<rootDir>/libs/database/src",
      "^@app/auth-service/(.*)$": "<rootDir>/libs/auth-service/src/$1",
      "^@app/auth-service$": "<rootDir>/libs/auth-service/src",
      "^@app/rag-service/(.*)$": "<rootDir>/libs/rag-service/src/$1",
      "^@app/rag-service$": "<rootDir>/libs/rag-service/src",
      "^@app/chat-service/(.*)$": "<rootDir>/libs/chat-service/src/$1",
      "^@app/chat-service$": "<rootDir>/libs/chat-service/src",
      "^@app/speech-service/(.*)$": "<rootDir>/libs/speech-service/src/$1",
      "^@app/speech-service$": "<rootDir>/libs/speech-service/src",
      "^@app/ingestion-service/(.*)$": "<rootDir>/libs/ingestion-service/src/$1",
      "^@app/ingestion-service$": "<rootDir>/libs/ingestion-service/src",
      "^@app/gateway/(.*)$": "<rootDir>/libs/gateway/src/$1",
      "^@app/gateway$": "<rootDir>/libs/gateway/src"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
